Package: nswtheme
Title: Apply the NSW Government Brand to Data Visualisations
Version: 0.0.0.9000
Authors@R: 
    person("Tyson", "Goddard", , "tyson.goddard@treasury.nsw.gov.au", role = c("aut", "cre"))
Description: Themes, colour palettes, scales and other tools for creating
    data visualisations and tables consistent with NSW Government brand
    guidelines. Provides themes and scales for 'ggplot2', formatting for
    'flextable', and helpers for common data visualisation tasks.
License: MIT + file LICENSE
Depends: 
    ggplot2 (>= 4.0.0),
    R (>= 4.1.0)
Imports: 
    dplyr,
    extrafont,
    flextable,
    lubridate,
    scales
Suggests: 
    ggpattern,
    ggtext,
    knitr,
    rmarkdown
Encoding: UTF-8
LazyData: true
VignetteBuilder: knitr
Roxygen: list(markdown = TRUE)
Config/roxygen2/version: 8.1.0
